# Copy to .env (gitignored) and fill in real values.
# All JSON configs reference these via {"type": "environment", "value": "VAR_NAME"}.
# ⚠️ The old hardcoded keys in this repo's git history are burned — use NEW keys only.

# ── RPC URLs: chains the Monitor watches ─────────────────────────────────────
# Ethereum mainnet: coworker's ETH node (get URL from him)
RPC_ETHEREUM_MAINNET=
# Sepolia: Infura with a NEW project key
RPC_SEPOLIA=https://sepolia.infura.io/v3/YOUR_NEW_INFURA_KEY

# ── RPC URLs: EVMCall target chains (used by the EVMCall script trigger) ─────
RPC_POLYGON=https://polygon-mainnet.infura.io/v3/YOUR_NEW_INFURA_KEY
RPC_OPTIMISM=https://optimism-mainnet.infura.io/v3/YOUR_NEW_INFURA_KEY
RPC_GNOSIS=https://rpc.gnosis.gateway.fm
RPC_CHIADO=https://rpc.chiado.gnosis.gateway.fm

# ── Notifications ─────────────────────────────────────────────────────────────
# If unset, alerts are still appended to logs/alerts.log (log-only mode).
# ⚠️ Block replay (--block) executes triggers: unset this or use a test channel
# when replaying historical blocks.
DISCORD_WEBHOOK_URL=

# ── External APIs (rotate the burned keys first) ─────────────────────────────
# priceMonitor (CoinMarketCap)
CMC_PRO_API_KEY=
# dvm BRL/CNY reference prices (exchangerate-api.com)
EXCHANGERATE_API_KEY=

# ── Monitor runtime (optional overrides) ─────────────────────────────────────
# RUST_LOG=info
# METRICS_ENABLED=false
